# Copy this file to .env.local and fill in the values you have.
# The site works with NONE of these set — it falls back to src/lib/sample-data.ts
# for content and shows friendly "not configured" states for forms/admin.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (CMS: projects, plans, elevations, amenities, company info) ---
# Create a free project at https://www.sanity.io/manage, then run the Studio at /studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed if your dataset is private / for server-side previews:
SANITY_API_READ_TOKEN=

# --- Supabase (leads, site visits, brochure requests, analytics, admin auth) ---
# Create a free project at https://supabase.com, then run supabase/migrations/0001_init.sql
# in the SQL editor, and insert your own email into admin_users.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Powers /admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications for new leads (Resend) ---
RESEND_API_KEY=
LEADS_EMAIL_FROM=leads@yourdomain.example
SALES_NOTIFICATION_EMAIL=sales@yourdomain.example
